# Facebook App Configuration
ACCESS_TOKEN=ADD_APP_TOKEN_HERE
APP_SECRET=ADD_APP_SECRET_HERE
APP_ID=ADD_APP_ID_HERE
VERIFY_TOKEN=ADD_VERIFY_TOKEN_HERE

# Server Configuration
PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379

# WhatsApp Business Account (required by scripts/webhook.js and scripts/doctor.js)
WABA_ID=ADD_WABA_ID_HERE
API_VERSION=v23.0

# Sender phone number id, needed by scripts/media.js (list them: npm run webhook -- phones)
PHONE_NUMBER_ID=ADD_PHONE_NUMBER_ID_HERE

# Public HTTPS URL Meta calls, written by scripts/tunnel.sh
WEBHOOK_CALLBACK_URL=ADD_WEBHOOK_CALLBACK_URL_HERE

# WhatsApp media IDs uploaded for your sender phone number
GROCERIES_MEDIA_ID=ADD_GROCERIES_MEDIA_ID_HERE
STRAWBERRIES_MEDIA_ID=ADD_STRAWBERRIES_MEDIA_ID_HERE
SHEET_PAN_DINNER_MEDIA_ID=ADD_SHEET_PAN_DINNER_MEDIA_ID_HERE
SALAD_BOWL_MEDIA_ID=ADD_SALAD_BOWL_MEDIA_ID_HERE
